<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain framework theme: no AppCompat dependency needed for a WebView shell.
         The window background matches the page so startup has no white flash. -->
    <style name="Theme.Void" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:colorPrimary">@color/void_bg</item>
        <item name="android:colorAccent">@color/void_accent</item>
        <item name="android:statusBarColor">@color/void_bg</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
