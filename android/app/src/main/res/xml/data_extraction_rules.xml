<?xml version="1.0" encoding="utf-8"?>
<!-- Never let the session token leave the device in a cloud or device-to-device
     backup. Signing in again is cheap; a leaked session is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
