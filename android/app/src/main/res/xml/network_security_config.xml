<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed, because this app is built to be pointed at a server you
  run yourself — including one on your own machine over your own WiFi, which has
  no certificate and never will.

  It is not a free-for-all. LoopApi.normaliseBase() defaults a bare hostname to
  https, so plaintext only ever happens when someone deliberately types
  "http://". The setup screen warns when that address is also a public one,
  which is the case where plaintext actually costs you something.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
